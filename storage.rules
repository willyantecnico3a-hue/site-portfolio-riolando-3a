rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function hasAdminRole() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/_roles_admin/$(request.auth.token.email)).data.active == true;
    }

    function hasCoordinatorRole() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/_roles_coordenacao/$(request.auth.token.email)).data.active == true;
    }

    match /{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /materiais/{allPaths=**} {
      allow read: if true;
      allow create, update: if (hasAdminRole() || hasCoordinatorRole())
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if hasAdminRole() || hasCoordinatorRole();
    }
  }
}
