{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.git/**",
      ".github/**",
      "**/.github/**",
      ".agents/**",
      "**/.agents/**",
      "**/.*",
      "**/.env*",
      "**/node_modules/**",
      "**/firebase-service-account*.json",
      "**/firebase-password-reset-links.csv",
      "functions/**",
      "netlify/**",
      "Arquivos Originais/**",
      "PROJETO,GRID/**",
      "scripts/**",
      "supabase_schema_exports/**",
      "**/*.sql",
      "package.json",
      "package-lock.json",
      "MIGRACAO_FIREBASE.md"
    ]
  }
}
