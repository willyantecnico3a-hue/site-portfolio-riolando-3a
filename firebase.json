{
  "functions": {
    "source": "functions",
    "runtime": "nodejs20"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "netlify/**",
      "Arquivos Originais/**",
      "PROJETO,GRID/**",
      "scripts/**",
      "supabase_schema_exports/**",
      "**/*.sql",
      "package.json",
      "package-lock.json",
      "MIGRACAO_FIREBASE.md"
    ],
    "rewrites": [
      {
        "source": "/api/database",
        "function": {
          "functionId": "databaseApi",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/horarios-professores",
        "function": {
          "functionId": "teacherSchedules",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/criar-aluno",
        "function": {
          "functionId": "createStudent",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/resetar-senha-aluno",
        "function": {
          "functionId": "resetStudentPassword",
          "region": "us-central1"
        }
      },
      {
        "source": "/api/generate-content",
        "function": {
          "functionId": "generateContent",
          "region": "us-central1"
        }
      }
    ]
  }
}
