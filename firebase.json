{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "**/.git/**",
      ".github/**",
      "**/.github/**",
      ".agents/**",
      "**/.agents/**",
      "**/.*",
      "**/.env*",
      "**/node_modules/**",
      "**/firebase-service-account*.json",
      "**/firebase-debug.log",
      "**/firebase-password-reset-links.csv",
      "functions/**",
      "netlify/**",
      "Arquivos Originais/**",
      "PROJETO,GRID/**",
      "scripts/**",
      "supabase_schema_exports/**",
      "**/*.sql",
      "package.json",
      "package-lock.json",
      "MIGRACAO_FIREBASE.md"
    ]
  }
}
